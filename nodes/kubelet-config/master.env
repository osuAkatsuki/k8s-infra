# Kubelet configuration for k8s-master01
# Location on node: /var/lib/kubelet/kubeadm-flags.env
#
# Master uses public IP for all networking (no --node-ip override)
# This is intentional as master handles minimal pod traffic (~0.7%)

KUBELET_KUBEADM_ARGS="--container-runtime-endpoint=unix:///run/cri-dockerd.sock --pod-infra-container-image=registry.k8s.io/pause:3.9"
