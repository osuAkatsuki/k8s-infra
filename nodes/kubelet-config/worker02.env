# Kubelet configuration for k8s-worker02
# Location on node: /var/lib/kubelet/kubeadm-flags.env
#
# Worker uses VPC IP (10.118.0.7) for InternalIP via --node-ip
# This enables kubelet API calls to use VPC network instead of public internet

KUBELET_KUBEADM_ARGS="--node-ip=10.118.0.7 --container-runtime-endpoint=unix:///run/cri-dockerd.sock --pod-infra-container-image=registry.k8s.io/pause:3.9"
